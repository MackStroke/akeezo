# ---------------------------------------------------------------------------
# AKEEZO — copy to .env and fill in. Never commit the real .env.
# ---------------------------------------------------------------------------

# NOTE: do NOT set NODE_ENV here. Vite reads this file too, and a pinned
# NODE_ENV=development makes `vite build` bundle React's development build
# (it roughly doubled the production bundle: 277 kB -> 532 kB). Vite infers
# its own mode from the command, and the API defaults to development when
# NODE_ENV is unset. Set NODE_ENV=production in the deploy environment only.

# --- API server ---
# API_PORT takes precedence over PORT. Use it locally so an ambient PORT
# (set by a dev harness or IDE task) cannot steal the frontend's port.
API_PORT=5000

# MongoDB connection string.
# Leave BLANK in local dev to use the JSON-file fallback store (server/.data).
# Production MUST set this.
#   local:  mongodb://localhost:27017/akeezo
#   atlas:  mongodb+srv://<user>:<pass>@<cluster>.mongodb.net/akeezo?retryWrites=true&w=majority
MONGODB_URI=mongodb://localhost:27017/akeezo

# Comma-separated list of origins allowed to call the API.
CORS_ORIGIN=http://localhost:5173

# --- Public contact details (surfaced in the UI) ---
# E.164 format, no spaces.
VITE_EMERGENCY_PHONE=+918287639443
VITE_WHATSAPP_NUMBER=918287639443
VITE_CONTACT_EMAIL=care@akeezo.com

# --- Client -> API ---
# Leave BLANK in dev: Vite proxies /api to the server, so the browser sees a
# single origin and CORS never applies. Set it only when the built frontend is
# served from a different origin than the API.
VITE_API_BASE_URL=

# --- Canonical site origin, used for JSON-LD + sitemap absolute URLs ---
VITE_SITE_URL=https://www.akeezo.com
